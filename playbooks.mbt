///|
/// Select policies applicable to one customer insight.
pub fn applicable_playbooks(
  item : CustomerInsight,
  catalog : Array[Playbook],
) -> Array[Playbook] {
  catalog.filter(policy => {
    item.churn.score >= policy.priority &&
    item.scores.recency <= policy.max_recency &&
    item.scores.frequency >= policy.min_frequency
  })
}

///|
/// Choose the highest-priority policy for a customer, if one applies.
pub fn best_playbook(
  item : CustomerInsight,
  catalog : Array[Playbook],
) -> Playbook? {
  let applicable = applicable_playbooks(item, catalog)
  if applicable.is_empty() {
    None
  } else {
    let ranked = applicable.copy()
    ranked.sort_by((left, right) => right.priority - left.priority)
    Some(ranked[0])
  }
}

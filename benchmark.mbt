]

///|
pub fn benchmark_case_count() -> Int {
  benchmark_cases.length()
}

///|
/// Materialize the benchmark rows as normal library events.
pub fn benchmark_events() -> Array[Event] {
  benchmark_cases.map(row => Event::new(row.customer_id, row.day, row.amount))
}

///|
/// A cheap correctness checksum used to detect accidental workload changes.
pub fn benchmark_checksum() -> Int {
  let mut checksum = 0
  for index, row in benchmark_cases {
    checksum = (checksum + (index + 1) * (row.day + row.amount)) % 1_000_000_007
  }
  checksum
}

///|
/// Run every principal analysis path on the fixed workload.
pub fn run_benchmark_workload() -> (Int, Int, Int, Int) {
  let events = benchmark_events()
  let report = analyze(events, 365)
  let summary = summarize(report)
  let rows = cohort_retention(events, 30, 12)
  let insight_rows = insights(report, ScoringConfig::default())
  (
    summary.total_customers,
    summary.total_value,
    rows.length(),
    insight_rows.length(),
  )
}
